# --- Model (any provider with tool calling) ---
# openrouter | openai | openai-compatible | anthropic
LLM_PROVIDER=openrouter
LLM_MODEL=
LLM_API_KEY=
# Only for openai-compatible servers (vLLM, Ollama, ...):
LLM_BASE_URL=

# --- Retrieval ---
# hybrid (BM25 + dense, default) | dense | bm25
RETRIEVAL_MODE=hybrid
# sentence-transformers (default) | hashing (offline, lower quality)
EMBEDDER=sentence-transformers

# --- Discord ---
DISCORD_BOT_TOKEN=
# Channel where escalations are posted (the human helpers' queue)
HELPERS_CHANNEL_ID=

# --- Storage ---
DB_PATH=agent.db
TRACES_DIR=traces
